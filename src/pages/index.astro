---
import Base from '../layouts/Base.astro';
import { liveTools, TOOLS } from '../core/tools/registry';
import { organizationJsonLd, websiteJsonLd } from '../lib/seo';

const live = liveTools();
const planned = TOOLS.filter((t) => t.status === 'planned');
const title = 'FastestAds — Fast, private checks for ad copy';
const description =
  'Free advertising tools that answer the question immediately — a Google Ads headline and ad copy checker, a CPM calculator, and more. No sign-up, nothing stored.';
---

<Base
  title={title}
  description={description}
  canonicalPath="/"
  jsonLd={[websiteJsonLd(), organizationJsonLd()]}
>
  <h1>FastestAds</h1>
  <p class="lead">
    Advertising tools that answer the question immediately: check ad copy against platform rules,
    solve CPM and ad-math in any direction — free, no sign-up, nothing stored.
  </p>

  <h2>Tools</h2>
  <ul class="tool-cards">
    {live.map((tool) => (
      <li>
        <a class="tool-card" href={tool.path}>
          <h3>{tool.name}</h3>
          <p>{tool.description}</p>
        </a>
      </li>
    ))}
  </ul>

  <h2>Coming next</h2>
  <p>{planned.map((t) => t.name).join(' · ')}</p>
</Base>
