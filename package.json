{
  "name": "fastestads",
  "version": "1.0.0",
  "description": "Fast checks for ad copy quality and platform fit.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && rm -f dist/server/.dev.vars dist/server/.prerender/.dev.vars",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "vitest run --config vitest.build.config.ts",
    "e2e": "playwright test",
    "perf": "node scripts/lighthouse.mjs",
    "live:jev": "LIVE_JEV=1 vitest run --config vitest.live.config.ts",
    "icons": "node scripts/gen-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.11.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.2",
    "preact": "10.29.8",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "globals": "^17.12.0",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "sharp": "^0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "wrangler": "^4.134.0"
  }
}
